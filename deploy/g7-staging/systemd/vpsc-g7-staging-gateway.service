[Unit]
Description=VPS Commander G7 isolated staging Gateway
After=network.target
Wants=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=vpsc-g7-staging-gateway
Group=vpsc-g7-staging-gateway
WorkingDirectory=/opt/vps-commander/g7-staging/current
Environment=PATH=/opt/vps-commander/bin:/usr/bin:/bin
Environment=NODE_ENV=production
UnsetEnvironment=NODE_TEST_CONTEXT NODE_OPTIONS NODE_V8_COVERAGE VPSC_STAGING_TEST_ACTIVE_JOB VPSC_STAGING_TEST_SCENARIO VPSC_STAGING_NODE VPSC_STAGING_MCP_ENTRYPOINT VPSC_STAGING_TRACE
ExecStartPre=/usr/bin/test -r /etc/vpsc-g7-staging-gateway/gateway.json
ExecStart=/opt/vps-commander/bin/node /opt/vps-commander/g7-staging/current/gateway/staging/server.mjs --persistent-staging --config /etc/vpsc-g7-staging-gateway/gateway.json
Restart=no
TimeoutStartSec=30s
TimeoutStopSec=35s
KillMode=control-group
UMask=0077
StateDirectory=vpsc-g7-staging-gateway
StateDirectoryMode=0700
ConfigurationDirectory=vpsc-g7-staging-gateway
ConfigurationDirectoryMode=0700
ReadWritePaths=/var/lib/vpsc-g7-staging-gateway
ReadOnlyPaths=/etc/vpsc-g7-staging-gateway /opt/vps-commander/g7-staging
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET
SystemCallArchitectures=native
TasksMax=64
MemoryMax=384M
CPUQuota=100%
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
